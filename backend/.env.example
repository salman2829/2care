# 2care AI Healthcare Operations Command Center Configuration
# Backend Environment Settings

ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL default, falls back to SQLite if unreachable or empty)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/healthcare_ops
SQLITE_FALLBACK_URL=sqlite:///./healthcare_ops.db

# API & Security
SECRET_KEY=dev_secret_key_change_in_production_2care_ops
API_PREFIX=/api
ALLOWED_ORIGINS=["http://localhost:8443","http://127.0.0.1:8443","http://localhost:5173","http://127.0.0.1:5173"]

# Retell AI Configuration (for voice agent integration)
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret_here

# Demo Mode Setting
DEMO_MODE=True
